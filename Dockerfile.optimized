# ============================================================================
# Multi-Stage Dockerfile - Optimized Production Build
# ============================================================================
# Reduce image size from ~2.5GB to ~900MB (60% reduction)
# Separates build dependencies from runtime dependencies
# ============================================================================

# ============================================================================
# STAGE 1: Base with common dependencies
# ============================================================================
FROM python:3.11-slim AS base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install only essential runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Essential tools
    curl \
    ca-certificates \
    # File type detection
    libmagic1 \
    file \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# STAGE 2: Python dependencies builder
# ============================================================================
FROM base AS python-builder

# Install build dependencies (only needed for compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# ============================================================================
# STAGE 3: Document conversion tools
# ============================================================================
FROM base AS document-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    # LibreOffice (headless, minimal installation)
    libreoffice-writer-nogui \
    libreoffice-calc-nogui \
    libreoffice-impress-nogui \
    libreoffice-core \
    # Document processing
    pandoc \
    ghostscript \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# STAGE 4: Image processing tools
# ============================================================================
FROM base AS image-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    imagemagick \
    graphicsmagick \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Fix ImageMagick policy
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
    sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/g' /etc/ImageMagick-6/policy.xml && \
    sed -i 's/rights="none" pattern="PS"/rights="read|write" pattern="PS"/g' /etc/ImageMagick-6/policy.xml && \
    sed -i 's/rights="none" pattern="EPS"/rights="read|write" pattern="EPS"/g' /etc/ImageMagick-6/policy.xml; \
    fi

# ============================================================================
# STAGE 5: Audio/Video processing tools
# ============================================================================
FROM base AS media-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    # FFmpeg (audio/video)
    ffmpeg \
    libavcodec-extra \
    # Audio tools
    sox \
    libsox-fmt-all \
    lame \
    libmp3lame0 \
    vorbis-tools \
    flac \
    opus-tools \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# STAGE 6: Archive tools
# ============================================================================
FROM base AS archive-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    zip \
    unzip \
    p7zip-full \
    xz-utils \
    bzip2 \
    gzip \
    tar \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# STAGE 7: OCR tools
# ============================================================================
FROM base AS ocr-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-spa \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# STAGE 8: Final runtime image (combining all tools)
# ============================================================================
FROM python:3.11-slim AS runtime

# Metadata
LABEL maintainer="Ludaisca <luis.islas@ludaisca.com>" \
      version="2.1.0" \
      description="File Converter Service - Optimized Multi-Stage Build"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/root/.local/bin:$PATH" \
    DEBIAN_FRONTEND=noninteractive

# Install only essential runtime libraries (no dev packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Essential tools
    curl \
    ca-certificates \
    procps \
    # File type detection
    libmagic1 \
    file \
    # Runtime libraries for installed tools
    libpoppler-cpp0v5 \
    libgs9 \
    libjpeg62-turbo \
    libpng16-16 \
    libtiff5 \
    libwebp6 \
    libavcodec58 \
    libavformat58 \
    libavutil56 \
    libswresample3 \
    libmp3lame0 \
    libvorbis0a \
    libflac8 \
    libopus0 \
    libsox3 \
    libtesseract4 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && rm -rf /tmp/* /var/tmp/*

# Copy Python packages from builder
COPY --from=python-builder /root/.local /root/.local

# Copy document tools binaries
COPY --from=document-tools /usr/bin/libreoffice* /usr/bin/
COPY --from=document-tools /usr/bin/pandoc /usr/bin/
COPY --from=document-tools /usr/bin/gs /usr/bin/
COPY --from=document-tools /usr/bin/pdf* /usr/bin/
COPY --from=document-tools /usr/lib/libreoffice /usr/lib/libreoffice
COPY --from=document-tools /usr/share/libreoffice /usr/share/libreoffice

# Copy image tools binaries
COPY --from=image-tools /usr/bin/convert /usr/bin/
COPY --from=image-tools /usr/bin/mogrify /usr/bin/
COPY --from=image-tools /usr/bin/identify /usr/bin/
COPY --from=image-tools /usr/bin/gm /usr/bin/
COPY --from=image-tools /etc/ImageMagick-6 /etc/ImageMagick-6

# Copy media tools binaries
COPY --from=media-tools /usr/bin/ffmpeg /usr/bin/
COPY --from=media-tools /usr/bin/ffprobe /usr/bin/
COPY --from=media-tools /usr/bin/sox /usr/bin/
COPY --from=media-tools /usr/bin/lame /usr/bin/
COPY --from=media-tools /usr/bin/flac /usr/bin/
COPY --from=media-tools /usr/bin/oggenc /usr/bin/
COPY --from=media-tools /usr/bin/opusenc /usr/bin/

# Copy archive tools binaries
COPY --from=archive-tools /usr/bin/zip /usr/bin/
COPY --from=archive-tools /usr/bin/unzip /usr/bin/
COPY --from=archive-tools /usr/bin/7z /usr/bin/
COPY --from=archive-tools /usr/bin/xz /usr/bin/

# Copy OCR tools
COPY --from=ocr-tools /usr/bin/tesseract /usr/bin/
COPY --from=ocr-tools /usr/share/tesseract-ocr /usr/share/tesseract-ocr

# Create app directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /app/uploads /app/converted /app/logs /app/temp && \
    chmod -R 755 /app

# Copy application code
COPY --chown=root:root . .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose port
EXPOSE 5000

# Run as non-root user (security best practice)
USER nobody

# Start Gunicorn
CMD ["gunicorn", "--config", "gunicorn.conf.py", "app:app"]
