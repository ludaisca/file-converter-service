# ============================================================================
# File Converter Service - Configuración de Entorno (.env)
# ============================================================================
# Este archivo contiene variables de configuración para la aplicación.
# Copia este archivo a .env y ajusta los valores según tu entorno.
# DO NOT commit .env to version control!
#
# Versión: 2.1.0 (12 de febrero de 2026)
# Última actualización: 2026-02-12
# Cambios: Agregadas configuraciones de Redis Cache y Gunicorn
# ============================================================================

# ============================================================================
# CONFIGURACIÓN DE FLASK
# ============================================================================
# Entorno de Flask (development/production)
# En desarrollo: facilita debugging
# En producción: desactiva debug mode y usa optimizaciones
FLASK_ENV=production

# Modo debug (True/False)
# NO usar True en producción
FLASK_DEBUG=False

# ============================================================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================================================
# Límite de tamaño de archivo en bytes (min: 1048576 = 1MB, max: 10485760000 = 10GB)
# Archivos más grandes serán rechazados
# Default: 52428800 (50 MB - ideal para documentos y pequeños videos)
# Para documentos: 10485760-52428800 (10-50 MB)
# Para imágenes: 52428800-104857600 (50-100 MB)
# Para videos: 104857600-1073741824 (100MB-1GB)
MAX_FILE_SIZE=52428800

# Carpeta para archivos subidos
# Default: /app/uploads
# NOTA: El contenedor crea automáticamente si no existe
UPLOAD_FOLDER=/app/uploads

# Carpeta para archivos convertidos
# Default: /app/converted
# NOTA: El contenedor crea automáticamente si no existe
CONVERTED_FOLDER=/app/converted

# ============================================================================
# CONFIGURACIÓN DE LOGGING
# ============================================================================
# Nivel de logging (DEBUG/INFO/WARNING/ERROR/CRITICAL)
# DEBUG: Más verboso, útil para desarrollo
# INFO: Normal, información general
# WARNING: Solo advertencias y errores
# ERROR: Solo errores
LOG_LEVEL=INFO

# Archivo de log
# Default: /app/logs/app.log
LOG_FILE=/app/logs/app.log

# Habilitar logging estructurado en JSON
# Default: False
# Usar True para mejor integración con sistemas de monitoreo
LOG_JSON=True

# ============================================================================
# CONFIGURACIÓN DE OCR
# ============================================================================
# Habilitar funcionalidad OCR (reconocimiento de texto)
# Default: True
# Requiere tesseract-ocr instalado en el sistema
ENABLE_OCR=True

# Idioma por defecto para OCR (eng/spa/fra/etc)
# Default: spa (español)
OCR_DEFAULT_LANGUAGE=spa

# Número máximo de páginas para OCR en PDF
# Default: 0 (sin límite)
# Usar > 0 para limitar y mejorar performance
OCR_MAX_PAGES=50

# ============================================================================
# CONFIGURACIÓN DE REDIS CACHE (NUEVO v2.1.0)
# ============================================================================
# Habilitar caché con Redis
# Default: True
# Mejora significativamente el performance para conversiones repetidas
REDIS_ENABLED=true

# Host de Redis
# En Docker Compose: usa el nombre del servicio (redis)
# En local: usa localhost o IP del servidor
# Default: redis
REDIS_HOST=redis

# Puerto de Redis
# Default: 6379 (puerto estándar)
REDIS_PORT=6379

# Base de datos de Redis (0-15)
# Default: 0
# Usar diferentes DBs para separar datos de diferentes servicios
REDIS_DB=0

# Contraseña de Redis
# Default: vacío (sin autenticación)
# En producción, SIEMPRE usar contraseña
# Ejemplo: REDIS_PASSWORD=tu_password_seguro_aqui
REDIS_PASSWORD=

# Timeout de socket de Redis en segundos
# Default: 5
# Aumentar si hay problemas de latencia de red
REDIS_SOCKET_TIMEOUT=5

# Timeout de conexión de Redis en segundos
# Default: 5
# Aumentar si Redis tarda en responder
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Tiempo de vida del caché en segundos
# Default: 86400 (24 horas)
# Valores comunes:
#   - 3600 = 1 hora
#   - 86400 = 24 horas (recomendado)
#   - 604800 = 7 días
#   - 2592000 = 30 días
CACHE_TTL=86400

# Tamaño máximo de archivo para cachear en bytes
# Default: 104857600 (100 MB)
# Archivos más grandes no se cachean (conversión directa)
# Ajustar según memoria disponible en Redis
CACHE_MAX_SIZE=104857600

# ============================================================================
# CONFIGURACIÓN DE GUNICORN (NUEVO v2.1.0)
# ============================================================================
# Número de workers (procesos)
# Formula recomendada: (2 x CPU cores) + 1
# Ejemplos:
#   - 2 cores = 5 workers
#   - 4 cores = 9 workers
#   - 8 cores = 17 workers
# Default: 4 (para servidor con 2 cores)
GUNICORN_WORKERS=4

# Número de threads por worker
# Recomendado: 2-4 threads por worker
# Más threads = más concurrencia, pero más memoria
# Default: 2
GUNICORN_THREADS=2

# Timeout de worker en segundos
# Debe ser mayor al tiempo máximo de conversión esperado
# Default: 300 (5 minutos)
# Para conversiones largas: 600-1800 (10-30 minutos)
GUNICORN_TIMEOUT=300

# Timeout de keep-alive en segundos
# Mantiene conexiones abiertas para reutilización
# Default: 5
GUNICORN_KEEPALIVE=5

# Máximo de requests por worker antes de reiniciar
# Previene memory leaks al reiniciar workers periódicamente
# Default: 1000
# Valores típicos: 500-2000
GUNICORN_MAX_REQUESTS=1000

# Jitter aleatorio para max_requests
# Evita que todos los workers se reinicien simultáneamente
# Default: 100
# Debe ser menor que GUNICORN_MAX_REQUESTS
GUNICORN_MAX_REQUESTS_JITTER=100

# ============================================================================
# CONFIGURACIÓN DE API
# ============================================================================
# Versión de la API
# Default: 2.1.0
# NO modificar a menos que actualices la API
API_VERSION=2.1.0

# Timeout para descargas desde URL en segundos
# Default: 30
DOWNLOAD_TIMEOUT=30

# ============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================================
# Habilitar CORS (Cross-Origin Resource Sharing)
# Default: True
# Usar False si solo se accede desde mismo origen
ENABLE_CORS=True

# Origenes CORS permitidos (separados por coma)
# Default: * (cualquier origen)
# Para producción, especificar dominios: https://ejemplo.com,https://otro.com
CORS_ORIGINS=*

# Máximo número de conversiones simultáneas por worker
# Default: 4
# Aumentar si tienes más CPU disponible
MAX_CONCURRENT_CONVERSIONS=4

# ============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN (COOLIFY)
# ============================================================================
# Usar esta sección al desplegar en Coolify

# En Coolify, las siguientes variables son normalmente configuradas por la plataforma:
# - Puerto: 5000 (mapeado internamente)
# - Dominio: e0kkgos0wok8kgo0o4gcksc8.orquestra.xyz (tu dominio)
# - SSL: Automático con Let's Encrypt
# - Health Check: /health (cada 30 segundos)

# Ejemplo de configuración optimizada para Coolify:
# FLASK_ENV=production
# FLASK_DEBUG=False
# MAX_FILE_SIZE=52428800
# LOG_LEVEL=INFO
# ENABLE_OCR=True
# REDIS_ENABLED=true
# REDIS_HOST=redis
# CACHE_TTL=86400
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=300
# API_VERSION=2.1.0

# ============================================================================
# CONFIGURACIÓN DE DESARROLLO (LOCAL)
# ============================================================================
# Para desarrollo local, descomenta y ajusta:

# FLASK_ENV=development
# FLASK_DEBUG=True
# LOG_LEVEL=DEBUG
# MAX_FILE_SIZE=104857600
# REDIS_ENABLED=false  # Opcional: desactivar Redis en dev
# GUNICORN_WORKERS=2   # Menos workers en dev
# GUNICORN_TIMEOUT=600 # Más tiempo para debugging

# ============================================================================
# NOTAS IMPORTANTES - v2.1.0
# ============================================================================
# 
# 1. NUEVAS CARACTERÍSTICAS (v2.1.0):
#    - Redis Cache: Mejora performance hasta 10x en conversiones repetidas
#    - Gunicorn: Servidor WSGI para producción con workers y threads
#    - Health Check mejorado: Incluye estado de Redis
#    - Nuevos endpoints: /cache/stats, /cache/clear
#
# 2. VARIABLES REQUERIDAS:
#    - Todas las variables tienen valores por defecto
#    - Redis es opcional pero altamente recomendado
#
# 3. VALIDACIÓN:
#    - Las variables se validan con Pydantic al iniciar
#    - Si hay error, la aplicación no inicia
#    - Revisa los logs si hay problemas de configuración
#
# 4. REDIS CACHE:
#    - Requiere contenedor Redis corriendo
#    - En Docker Compose: automático con depends_on
#    - Almacena conversiones para reutilización
#    - Política: LRU (Least Recently Used)
#    - Memoria recomendada: 256MB-1GB según carga
#
# 5. GUNICORN:
#    - Usado automáticamente en producción
#    - Workers: procesos independientes
#    - Threads: concurrencia dentro de cada worker
#    - Total conexiones simultáneas: WORKERS x THREADS
#    - Ejemplo: 4 workers x 2 threads = 8 conexiones simultáneas
#
# 6. PERFORMANCE:
#    - Con Redis: conversiones idénticas son instantáneas
#    - Sin Redis: cada conversión se procesa desde cero
#    - Gunicorn workers: distribución automática de carga
#    - Threads: mejor uso de CPU en operaciones I/O
#
# 7. MONITOREO:
#    - GET /health: Estado general + Redis + métricas
#    - GET /cache/stats: Estadísticas detalladas del caché
#    - POST /cache/clear: Limpiar caché (admin)
#
# 8. SEGURIDAD DE REDIS:
#    - En producción: SIEMPRE usar REDIS_PASSWORD
#    - Firewall: Solo permitir conexiones internas
#    - No exponer puerto 6379 públicamente
#    - Usar Redis 7+ con ACL para mayor seguridad
#
# 9. TROUBLESHOOTING:
#    - Redis no conecta: Verificar REDIS_HOST y puerto
#    - Workers crashean: Aumentar GUNICORN_TIMEOUT
#    - Memory leaks: Reducir GUNICORN_MAX_REQUESTS
#    - Conversiones lentas: Aumentar GUNICORN_WORKERS
#    - Caché no funciona: Verificar REDIS_ENABLED=true
#
# 10. ESCALABILIDAD:
#     - Workers: Escalar según CPU disponible
#     - Redis: Aumentar memoria según carga
#     - Cache TTL: Balance entre performance y storage
#     - Max file size cache: Ajustar según RAM de Redis
#
# ============================================================================

